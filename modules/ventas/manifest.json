{
  "name": "ventas",
  "label": "Ventas",
  "version": "1.0.0",
  "author": "Ecuabyte",
  "description": "Punto de venta (POS): cobrás y el stock baja solo. Usa el catálogo del módulo Operaciones y los clientes de Contactos.",
  "icon": "🛒",
  "depends": ["products", "contacts"],
  "frontend": {
    "pages": [
      {
        "name": "VentasPage",
        "path": "/admin/ventas",
        "label": "Ventas",
        "icon": "🛒"
      }
    ]
  },
  "models": {
    "sale": {
      "name": "sale",
      "label": "Venta",
      "fields": {
        "partner_id": {
          "type": "string",
          "length": 60,
          "index": true,
          "label": "Cliente",
          "sequence": 10
        },
        "customer_name": {
          "type": "string",
          "length": 200,
          "label": "Nombre del cliente",
          "sequence": 20
        },
        "status": {
          "type": "string",
          "length": 20,
          "options": ["done", "cancelled"],
          "default": "done",
          "label": "Estado",
          "sequence": 30
        },
        "paid_method": {
          "type": "string",
          "length": 20,
          "options": ["efectivo", "transferencia", "tarjeta"],
          "default": "efectivo",
          "label": "Forma de pago",
          "sequence": 40
        },
        "subtotal": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Subtotal",
          "sequence": 50
        },
        "total": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Total",
          "sequence": 60
        },
        "note": {
          "type": "text",
          "label": "Nota",
          "sequence": 70
        }
      },
      "workflow": {
        "field": "status",
        "initial": "done",
        "transitions": {
          "cancelar": {
            "from": ["done"],
            "to": "cancelled",
            "label": "Anular"
          }
        }
      }
    },
    "sale_line": {
      "name": "sale_line",
      "label": "Línea de venta",
      "fields": {
        "sale_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "index": true,
          "label": "Venta",
          "sequence": 10
        },
        "product_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "label": "Producto",
          "sequence": 20
        },
        "product_name": {
          "type": "string",
          "length": 200,
          "label": "Nombre del producto",
          "sequence": 30
        },
        "quantity": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "required": true,
          "label": "Cantidad",
          "sequence": 40
        },
        "unit_price": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "required": true,
          "label": "Precio unitario",
          "sequence": 50
        },
        "line_total": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Total línea",
          "sequence": 60
        }
      }
    }
  }
}
