{
  "name": "importaciones",
  "label": "Importaciones",
  "version": "1.0.0",
  "author": "Ecuabyte",
  "description": "Importás mercadería y repartís flete + aduana + seguro sobre cada producto para saber su costo real de reventa (landed cost). Sirve para autos, comida, lo que sea. Al recibir, el stock sube con ese costo.",
  "icon": "🚢",
  "depends": ["products", "contacts"],
  "models": {
    "import_order": {
      "name": "import_order",
      "label": "Importación",
      "fields": {
        "supplier_id": {
          "type": "string",
          "length": 60,
          "index": true,
          "label": "Proveedor",
          "sequence": 10
        },
        "supplier_name": {
          "type": "string",
          "length": 200,
          "label": "Nombre del proveedor",
          "sequence": 20
        },
        "reference": {
          "type": "string",
          "length": 120,
          "label": "Referencia (BL / factura)",
          "sequence": 30
        },
        "currency": {
          "type": "string",
          "length": 10,
          "default": "USD",
          "label": "Moneda",
          "sequence": 40
        },
        "status": {
          "type": "string",
          "length": 20,
          "options": ["draft", "in_transit", "customs", "received", "cancelled"],
          "default": "draft",
          "label": "Estado",
          "sequence": 50
        },
        "freight_cost": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Flete",
          "sequence": 60
        },
        "customs_cost": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Aduana / aranceles",
          "sequence": 70
        },
        "insurance_cost": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Seguro",
          "sequence": 80
        },
        "other_cost": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Otros gastos",
          "sequence": 90
        },
        "goods_total": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Total mercadería (FOB)",
          "sequence": 100
        },
        "landed_total": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "Costo total en destino",
          "sequence": 110
        },
        "eta": {
          "type": "date",
          "label": "Llegada estimada",
          "sequence": 120
        },
        "note": {
          "type": "text",
          "label": "Nota",
          "sequence": 130
        }
      },
      "workflow": {
        "field": "status",
        "initial": "draft",
        "transitions": {
          "enviar": {
            "from": ["draft"],
            "to": "in_transit",
            "label": "En tránsito"
          },
          "aduana": {
            "from": ["in_transit"],
            "to": "customs",
            "label": "En aduana"
          },
          "recibir": {
            "from": ["customs", "in_transit"],
            "to": "received",
            "label": "Recibir"
          },
          "cancelar": {
            "from": ["draft", "in_transit", "customs"],
            "to": "cancelled",
            "label": "Cancelar"
          }
        }
      }
    },
    "import_line": {
      "name": "import_line",
      "label": "Línea de importación",
      "fields": {
        "import_order_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "index": true,
          "label": "Importación",
          "sequence": 10
        },
        "product_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "label": "Producto",
          "sequence": 20
        },
        "product_name": {
          "type": "string",
          "length": 200,
          "label": "Nombre del producto",
          "sequence": 30
        },
        "quantity": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "required": true,
          "label": "Cantidad",
          "sequence": 40
        },
        "unit_fob": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "required": true,
          "label": "Costo FOB unitario",
          "sequence": 50
        },
        "line_fob": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "label": "FOB de la línea",
          "sequence": 60
        },
        "landed_unit_cost": {
          "type": "decimal",
          "precision": 12,
          "scale": 4,
          "label": "Costo real por unidad",
          "sequence": 70
        }
      }
    }
  }
}
