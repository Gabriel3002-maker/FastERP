{
  "name": "integracion_odoo_fasterp",
  "version": "2.0.1",
  "label": "Integraci\u00f3n Odoo",
  "description": "Sincronizaci\u00f3n bidireccional de productos, pedidos, leads y stock entre Odoo y FastERP",
  "author": "Ecuabyte",
  "icon": "refresh-cw",
  "main": "module.wasm",
  "permissions": [
    "database.read",
    "database.write",
    "network.http",
    "external.odoo"
  ],
  "api_endpoints": {
    "test_connection": "POST /api/odoo/test-connection",
    "sync_products": "POST /api/odoo/sync/products",
    "push_order": "POST /api/odoo/push/order",
    "push_lead": "POST /api/odoo/push/lead",
    "push_product": "POST /api/odoo/push/product",
    "push_stock": "POST /api/odoo/push/stock"
  },
  "frontend": {
    "entry": "frontend/index.ts",
    "pages": [
      {
        "name": "OdooPage",
        "path": "/admin/odoo",
        "label": "Integraci\u00f3n Odoo",
        "icon": "refresh-cw"
      }
    ]
  }
}