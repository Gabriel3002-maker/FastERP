{
  "name": "contacts",
  "label": "Contactos",
  "version": "1.0.0",
  "author": "EcuaByte",
  "description": "Gestión de contactos con datos tributarios para LATAM",
  "icon": "👥",
  "models": {
    "contact": {
      "name": "contact",
      "label": "Contacto",
      "fields": {
        "name": {
          "type": "string",
          "length": 160,
          "required": true,
          "index": true,
          "label": "Nombre",
          "example": "María López"
        },
        "email": {
          "type": "email",
          "length": 160,
          "label": "Correo electrónico",
          "example": "maria@empresa.com"
        },
        "phone": {
          "type": "phone",
          "length": 30,
          "label": "Teléfono"
        },
        "mobile": {
          "type": "phone",
          "length": 30,
          "label": "Celular"
        },
        "company": {
          "type": "string",
          "length": 160,
          "index": true,
          "label": "Empresa"
        },
        "job_title": {
          "type": "string",
          "length": 120,
          "label": "Cargo"
        },

        "tax_id_type": {
          "type": "string",
          "length": 20,
          "label": "Tipo de identificación",
          "options": ["RUC", "CEDULA", "PASAPORTE", "NIT", "RFC", "CUIT"],
          "help": "Documento tributario según el país."
        },
        "tax_id": {
          "type": "string",
          "length": 20,
          "index": true,
          "label": "Número de identificación",
          "example": "1790012345001"
        },
        "person_type": {
          "type": "string",
          "length": 20,
          "label": "Tipo de persona",
          "options": ["NATURAL", "JURIDICA"]
        },
        "tax_regime": {
          "type": "string",
          "length": 60,
          "label": "Régimen tributario"
        },
        "accounting_obligation": {
          "type": "string",
          "length": 20,
          "label": "Obligado a llevar contabilidad",
          "options": ["SI", "NO"]
        },
        "retention_agent": {
          "type": "string",
          "length": 20,
          "label": "Agente de retención",
          "options": ["SI", "NO"]
        },
        "credit_limit": {
          "type": "money",
          "precision": 14,
          "scale": 2,
          "label": "Límite de crédito"
        },

        "address": {
          "type": "text",
          "label": "Dirección"
        },
        "city": {
          "type": "string",
          "length": 80,
          "label": "Ciudad"
        },
        "province": {
          "type": "string",
          "length": 80,
          "label": "Provincia / Estado"
        },
        "country": {
          "type": "string",
          "length": 80,
          "label": "País"
        },
        "postal_code": {
          "type": "string",
          "length": 20,
          "label": "Código postal"
        },
        "website": {
          "type": "url",
          "length": 200,
          "label": "Sitio web"
        },
        "notes": {
          "type": "text",
          "label": "Notas"
        }
      }
    }
  }
}
