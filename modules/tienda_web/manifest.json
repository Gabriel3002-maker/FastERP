{
  "name": "tienda_web",
  "version": "2.0.1",
  "label": "Tienda Web",
  "description": "Mini-tienda para gestionar productos sincronizados: nombre, descripción y galería de imágenes tipo Amazon",
  "author": "Ecuabyte",
  "icon": "store",
  "main": "module.wasm",
  "permissions": [
    "database.read",
    "database.write",
    "file.upload"
  ],
  "depends": ["integracion_odoo_fasterp"],
  "frontend": {
    "entry": "frontend/index.ts",
    "pages": [
      {
        "name": "StorePage",
        "path": "/admin/tienda",
        "label": "Tienda",
        "icon": "store"
      }
    ]
  },
  "api_endpoints": {
    "list_products": "GET /api/store/products",
    "get_product": "GET /api/store/products/:odooId",
    "update_product": "PUT /api/store/products/:odooId",
    "upload_image": "POST /api/store/products/:odooId/images",
    "delete_image": "DELETE /api/store/images/:id"
  }
}
