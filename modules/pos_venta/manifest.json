{
  "name": "pos_venta",
  "label": "POS Venta",
  "version": "1.0.0",
  "author": "EcuaByte",
  "description": "Terminal de punto de venta con sincronización de inventario, compra/venta integrada con otros módulos. Compatible con múltiples sucursales y formas de pago.",
  "icon": "🛒",
  "frontend": {
    "pages": [
      {
        "name": "POSVentaPage",
        "path": "/admin/pos-venta",
        "label": "POS Venta",
        "icon": "🛒"
      }
    ]
  },
  "models": {
    "punto_venta": {
      "name": "punto_venta",
      "label": "Punto de Venta",
      "fields": {
        "nombre": {
          "type": "string",
          "length": 120,
          "required": true,
          "label": "Nombre",
          "example": "Terminal 1 - Mostrador",
          "sequence": 10
        },
        "sucursal": {
          "type": "string",
          "length": 80,
          "label": "Sucursal",
          "example": "Matriz",
          "sequence": 20
        },
        "numero_serie": {
          "type": "string",
          "length": 60,
          "label": "Número de serie",
          "help": "Identificador único de la terminal",
          "sequence": 30
        },
        "activo": {
          "type": "boolean",
          "label": "Activo",
          "default": true,
          "sequence": 40
        }
      }
    },
    "venta": {
      "name": "venta",
      "label": "Venta",
      "fields": {
        "numero_documento": {
          "type": "string",
          "length": 60,
          "required": true,
          "label": "Documento",
          "help": "Factura, Boleta, etc.",
          "sequence": 10
        },
        "tipo_documento": {
          "type": "string",
          "length": 20,
          "label": "Tipo",
          "options": ["factura", "boleta", "nota_credito"],
          "default": "boleta",
          "sequence": 15
        },
        "punto_venta_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "index": true,
          "label": "Punto de Venta",
          "sequence": 20
        },
        "cliente_id": {
          "type": "string",
          "length": 60,
          "label": "Cliente",
          "help": "Cliente del módulo Contactos",
          "sequence": 30
        },
        "cliente_nombre": {
          "type": "string",
          "length": 160,
          "label": "Nombre cliente",
          "sequence": 35
        },
        "fecha_venta": {
          "type": "datetime",
          "required": true,
          "label": "Fecha",
          "sequence": 40
        },
        "subtotal": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "label": "Subtotal",
          "readonly": true,
          "sequence": 50
        },
        "impuesto": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "label": "Impuesto (IVA)",
          "sequence": 60
        },
        "total": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "required": true,
          "label": "Total",
          "sequence": 70
        },
        "estado": {
          "type": "string",
          "length": 20,
          "label": "Estado",
          "options": ["borrador", "pagada", "anulada"],
          "default": "borrador",
          "sequence": 80
        },
        "observaciones": {
          "type": "text",
          "label": "Observaciones",
          "sequence": 90
        }
      }
    },
    "linea_venta": {
      "name": "linea_venta",
      "label": "Línea de Venta",
      "fields": {
        "venta_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "index": true,
          "label": "Venta",
          "sequence": 10
        },
        "producto_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "label": "Producto",
          "help": "Producto del módulo de Inventario",
          "sequence": 20
        },
        "producto_nombre": {
          "type": "string",
          "length": 160,
          "label": "Nombre",
          "sequence": 25
        },
        "cantidad": {
          "type": "decimal",
          "precision": 18,
          "scale": 4,
          "required": true,
          "label": "Cantidad",
          "sequence": 30
        },
        "precio_unitario": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "required": true,
          "label": "Precio Unitario",
          "sequence": 40
        },
        "descuento_porcentaje": {
          "type": "decimal",
          "precision": 5,
          "scale": 2,
          "label": "Descuento %",
          "default": 0,
          "sequence": 50
        },
        "subtotal": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "readonly": true,
          "label": "Subtotal",
          "sequence": 60
        },
        "secuencia": {
          "type": "integer",
          "label": "Secuencia",
          "sequence": 70
        }
      }
    },
    "pago_venta": {
      "name": "pago_venta",
      "label": "Pago de Venta",
      "fields": {
        "venta_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "index": true,
          "label": "Venta",
          "sequence": 10
        },
        "metodo_pago": {
          "type": "string",
          "length": 30,
          "required": true,
          "label": "Método de Pago",
          "options": ["efectivo", "tarjeta_credito", "tarjeta_debito", "transferencia", "cheque", "billetera_digital"],
          "sequence": 20
        },
        "monto": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "required": true,
          "label": "Monto",
          "sequence": 30
        },
        "referencia": {
          "type": "string",
          "length": 120,
          "label": "Referencia",
          "help": "Número de transacción, cheque, etc.",
          "sequence": 40
        },
        "fecha_pago": {
          "type": "datetime",
          "required": true,
          "label": "Fecha de Pago",
          "sequence": 50
        }
      }
    },
    "compra": {
      "name": "compra",
      "label": "Compra",
      "fields": {
        "numero_documento": {
          "type": "string",
          "length": 60,
          "required": true,
          "label": "Documento",
          "sequence": 10
        },
        "proveedor_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "label": "Proveedor",
          "help": "Proveedor del módulo Contactos",
          "sequence": 20
        },
        "proveedor_nombre": {
          "type": "string",
          "length": 160,
          "label": "Nombre proveedor",
          "sequence": 25
        },
        "fecha_compra": {
          "type": "datetime",
          "required": true,
          "label": "Fecha",
          "sequence": 30
        },
        "fecha_vencimiento": {
          "type": "datetime",
          "label": "Vencimiento",
          "sequence": 35
        },
        "subtotal": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "readonly": true,
          "label": "Subtotal",
          "sequence": 40
        },
        "impuesto": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "label": "Impuesto",
          "sequence": 50
        },
        "total": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "required": true,
          "label": "Total",
          "sequence": 60
        },
        "estado": {
          "type": "string",
          "length": 20,
          "label": "Estado",
          "options": ["borrador", "recibida", "pagada", "anulada"],
          "default": "borrador",
          "sequence": 70
        }
      }
    },
    "linea_compra": {
      "name": "linea_compra",
      "label": "Línea de Compra",
      "fields": {
        "compra_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "index": true,
          "label": "Compra",
          "sequence": 10
        },
        "producto_id": {
          "type": "string",
          "length": 60,
          "required": true,
          "label": "Producto",
          "sequence": 20
        },
        "producto_nombre": {
          "type": "string",
          "length": 160,
          "label": "Nombre",
          "sequence": 25
        },
        "cantidad": {
          "type": "decimal",
          "precision": 18,
          "scale": 4,
          "required": true,
          "label": "Cantidad",
          "sequence": 30
        },
        "precio_unitario": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "required": true,
          "label": "Precio Unitario",
          "sequence": 40
        },
        "subtotal": {
          "type": "decimal",
          "precision": 18,
          "scale": 2,
          "readonly": true,
          "label": "Subtotal",
          "sequence": 50
        }
      }
    }
  }
}
