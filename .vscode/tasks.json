{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Core: build",
      "type": "shell",
      "command": "go build ./...",
      "cwd": "${workspaceFolder}/core",
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Core: test",
      "type": "shell",
      "command": "go test ./...",
      "cwd": "${workspaceFolder}/core",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Core: vet",
      "type": "shell",
      "command": "go vet ./...",
      "cwd": "${workspaceFolder}/core",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Módulos: recompilar WASM",
      "type": "shell",
      "command": "for d in ../modules/*/; do if [ -f \"$d/main.go\" ]; then echo \"==> $(basename $d)\"; (cd \"$d\" && GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o module.wasm main.go) || echo \"    FALLO\"; fi; done",
      "cwd": "${workspaceFolder}/core",
      "problemMatcher": []
    },
    {
      "label": "Módulos: actualizar submodule",
      "type": "shell",
      "command": "git submodule update --init --recursive",
      "cwd": "${workspaceFolder}",
      "problemMatcher": []
    },
    {
      "label": "DB: comprobar conexión",
      "type": "shell",
      "command": "psql \"${FASTERP_DATABASE_URL:-postgres://fasterp:fasterp@localhost:5456/fasterp?sslmode=disable}\" -c 'SELECT version();'",
      "problemMatcher": []
    }
  ]
}
