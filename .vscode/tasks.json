{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Core: build",
      "type": "shell",
      "command": "go build ./...",
      "cwd": "${workspaceFolder}/core",
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Core: test",
      "type": "shell",
      "command": "go test ./...",
      "cwd": "${workspaceFolder}/core",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Core: vet",
      "type": "shell",
      "command": "go vet ./...",
      "cwd": "${workspaceFolder}/core",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Módulos: actualizar submodule",
      "type": "shell",
      "command": "git submodule update --init --recursive",
      "cwd": "${workspaceFolder}",
      "problemMatcher": []
    },
    {
      "label": "DB: comprobar conexión",
      "type": "shell",
      "command": "psql \"${FASTERP_DATABASE_URL:-postgres://fasterp:fasterp@localhost:5456/fasterp?sslmode=disable}\" -c 'SELECT version();'",
      "problemMatcher": []
    }
  ]
}
