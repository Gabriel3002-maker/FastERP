{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Run (dev)",
      "type": "shell",
      "command": "cd backend && go run ./cmd/server",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Server starting.*",
          "endsPattern": "^.*$"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true
      }
    },
    {
      "label": "Frontend: Run (dev)",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*Local:.*",
          "endsPattern": "^.*$"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Database: Check",
      "type": "shell",
      "command": "psql -U odoo17 -h localhost -d fasterp -c 'SELECT version();'",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Module",
      "type": "shell",
      "command": "make build-module MODULE=${input:modulePath}",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "modulePath",
      "type": "promptString",
      "description": "Enter module path (e.g., ./modules/examples/hello-world)",
      "default": "./modules/examples/hello-world"
    }
  ]
}
