# Plantilla de configuración. Copiar a .env y rellenarlo:
#
#     cp .env.example .env
#
# .env está en .gitignore: no se commitea. Esta plantilla sí, y no lleva ningún
# valor real a propósito — un secreto por defecto publicado permite forjar tokens
# de admin sin credenciales.

# ── Base de datos ─────────────────────────────────────────────────────────────

# Contraseña del superusuario de Postgres. Solo se usa para los scripts de
# inicialización del volumen.
POSTGRES_PASSWORD=

# Contraseña del rol restringido `fasterp_app` con el que se conecta la app.
# docker/init-db.sh lo crea con NOSUPERUSER y NOBYPASSRLS, para que las políticas
# RLS se apliquen de verdad.
FASTERP_APP_PASSWORD=

# Cadena de conexión completa. Solo si se overrides el comportamiento normal de
# run.sh, que la compone a partir del usuario y la contraseña de arriba.
# FASTERP_DATABASE_URL=postgres://fasterp_app:CLAVE@localhost:5456/fasterp?sslmode=disable

# Puerto de Postgres publicado en loopback. No hace falta cambiarlo.
FASTERP_PG_PORT=5456

# ── Secretos de firma (obligatorios) ──────────────────────────────────────────

# Generar con: openssl rand -hex 32
#
# Firman los access tokens. Quien conozca el valor puede emitir un token de
# admin para cualquier tenant de esta instancia, así que se trata como una
# credencial de producción, no como un ajuste de configuración. Mínimo 16
# caracteres, y distinto del de refresh.
FASTERP_JWT_SECRET=

# Generar aparte: openssl rand -hex 32
FASTERP_JWT_REFRESH_SECRET=

# ── Arranque ──────────────────────────────────────────────────────────────────

# Puerto HTTP. El compose lo publica solo en 127.0.0.1; para exponerlo hace
# falta un proxy inverso delante, no abrir el puerto.
FASTERP_PORT=7071
FASTERP_BIND_PORT=7071

# true  → crea tenant y cuenta admin en el primer arranque.
# false → el servidor arranca sin usuarios; el primero se crea en /setup.
#
# Si se pone true, hace falta FASTERP_ADMIN_PASSWORD (mínimo 12 caracteres), y
# el servidor NO arranca sin ella. Ya no existe una contraseña de admin fija.
FASTERP_SEED=false

# Contraseña de la cuenta admin que crea el seed. Se ignora si FASTERP_SEED=false.
FASTERP_ADMIN_PASSWORD=

# true → permite arrancar con secretos débiles o de ejemplo, avisando por log.
# Nunca en producción: es exactamente lo que convierte un secreto de relleno en
# una puerta abierta.
FASTERP_DEV=false

# ── Red ───────────────────────────────────────────────────────────────────────

# Orígenes permitidos por CORS, separados por coma. Sin comodines: "*" haría que
# cualquier sitio se considere de confianza. Poner el dominio real del admin.
FASTERP_CORS_ORIGINS=http://localhost:7071

# CIDRs de los proxies de confianza, separados por coma. Vacío = solo se cuenta
# la dirección del peer, y un X-Forwarded-For del cliente no falsea el rate limit.
# Con Caddy o Traefik delante: FASTERP_TRUSTED_PROXIES=172.16.0.0/12
FASTERP_TRUSTED_PROXIES=

# Peticiones por minuto y IP, en total y en /api/auth/*.
FASTERP_RATE_LIMIT=100
FASTERP_AUTH_RATE_LIMIT=10

# ── Rutas ─────────────────────────────────────────────────────────────────────

# Dónde busca los módulos. run.sh y el compose lo ponen por su cuenta.
# FASTERP_MODULES_DIR=./modules
# FASTERP_UPLOAD_DIR=./core/uploads

# ── Pool de conexiones ────────────────────────────────────────────────────────

FASTERP_DB_MAX_OPEN=50
FASTERP_DB_MAX_IDLE=10
