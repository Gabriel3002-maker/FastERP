# Secretos — NUNCA commitear. Usar .env.example como plantilla.
.env
.env.*
!.env.example
.default-tenant-id

# Binarios compilados
bin/
*.so
core/backend
core/test-build
core/fasterp-core

# Los .wasm compilados sí se versionan: docker-compose monta ./modules y el backend
# los carga al arrancar, así que un clon limpio necesita tenerlos.
*.wasm
!modules/**/*.wasm

# Datos en tiempo de ejecución
uploads/
*.log

# Frontend
node_modules/
dist/

# Paquetes de módulos
*.zip

# Editor / SO
.DS_Store
*.swp

# Ajustes locales de Claude: nunca se versionan (contienen rutas y credenciales de la maquina)
.claude/settings.local.json
